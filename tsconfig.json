{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": true,
		"checkJs": false,
		"allowImportingTsExtensions": true,
        "noEmit": true,
		"noCheck": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
	},
	"include": ["*.ts", "lib/**/*.ts"]
}